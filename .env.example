# Everyware — Laravel
# Docker (Sail): gebruik DB_HOST=mysql. Zonder Docker (lokaal Apache/MySQL): gebruik DB_HOST=127.0.0.1

APP_NAME=Everyware
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Laravel Sail (Docker): poort van de app. Zonder Sail wordt dit niet gebruikt.
APP_PORT=80

# Laravel Sail: gebruikers-ID voor bestandsrechten (Linux/Mac vaak 1000, WSL idem)
WWWGROUP=1000
WWWUSER=1000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Sail: mysql (servicenaam). Lokaal (Apache/MySQL): 127.0.0.1
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=everyware
DB_USERNAME=root
DB_PASSWORD=


DB_PERSONAL_CONNECTION=mysql
DB_PERSONAL_HOST=mysql-personal
DB_PERSONAL_PORT=3306
DB_PERSONAL_DATABASE=everyware_personal
DB_PERSONAL_USERNAME=root
DB_PERSONAL_PASSWORD=
DB_PERSONAL_SCHEMA=public
DB_PERSONAL_SSLMODE=prefer

# Vercel/Supabase personal-data database example:
# DB_PERSONAL_CONNECTION=pgsql
# DB_PERSONAL_HOST=aws-0-eu-west-1.pooler.supabase.com
# DB_PERSONAL_PORT=5432
# DB_PERSONAL_DATABASE=postgres
# DB_PERSONAL_USERNAME=postgres.your-project-ref
# DB_PERSONAL_PASSWORD=
# DB_PERSONAL_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SURVEY_IMAGES_DISK=public
PUBLIC_DISK_URL=/storage
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=api
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optioneel: Vite dev-server poort (Sail default 5173). FORWARD_DB_PORT forwardt de hoofd-MySQL op host.
# FORWARD_DB_PERSONAL_PORT forwardt de persoonlijke-data MySQL op host.
# VITE_PORT=5173
FORWARD_DB_PORT=3306
FORWARD_DB_PERSONAL_PORT=3307

VITE_APP_NAME="${APP_NAME}"
